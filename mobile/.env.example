# Base URL of the agentic backend (autonomous-content-to-action-agent/backend).
# Pick the value appropriate for your runtime target:
#   - Android emulator:        http://10.0.2.2:8000
#   - iOS simulator:           http://localhost:8000
#   - Physical device on LAN:  http://<your-lan-ip>:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Operator handle embedded in HITL signature strings.
# If omitted/empty, the app shows a one-time Operator Provisioning screen on
# first launch and persists the handle in expo-secure-store.
EXPO_PUBLIC_OPERATOR_HANDLE=
